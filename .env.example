# Copy this file to `.env` and fill in real values.
# `.env` itself is git-ignored — NEVER commit real secrets.

# --- Core Django ---
# Generate one with:
#   python manage.py shell -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=change-me

# Comma-separated list, e.g. localhost,127.0.0.1
ALLOWED_HOSTS=localhost,127.0.0.1

# --- Database ---
# Format: postgres://USER:PASSWORD@HOST:PORT/NAME
# In dev.py this has a sqlite fallback if unset; in prod.py it is required.
DATABASE_URL=postgres://securescan:securescan@localhost:5432/securescan

# --- Email (used from Milestone 1.3 onward for verification/reset emails) ---
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
